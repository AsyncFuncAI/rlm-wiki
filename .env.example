# Copy this file to `.env` and fill in the values.
#   cp .env.example .env
# Bun auto-loads `.env` when you run `bun run server`.

# Web user runs are BYOK-only: users must add provider keys through
# the in-app "model access" panel. These env vars are for local CLI/dev
# workflows and do not make production web runs spend platform keys.

# ── Gemini 3.1 Pro ──────────────────────────────────────────────
# Local CLI/dev key for Gemini channels.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ── Cloudflare Workers AI (Kimi K2.6) ───────────────────────────
# Required for the `kimi-k2.6` channel.
# Token:      https://dash.cloudflare.com/profile/api-tokens  (permission: Workers AI)
# Account ID: right sidebar on your Cloudflare dashboard homepage
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# ── DeepSeek direct API ──────────────────────────────────────────
# Add numbered keys to pool requests and reduce per-key rate-limit pressure.
DEEPSEEK_API_KEY=
# DEEPSEEK_API_KEY_2=
# DEEPSEEK_API_KEY_3=
# Or comma/newline-separated:
# DEEPSEEK_API_KEYS=

# ── Graphify safety gate ─────────────────────────────────────────
# Docker installs `tokei`; repos above either threshold do not receive
# graphify tools at all.
RLM_GRAPHIFY_TOKEI_MAX_CODE_LINES=150000
RLM_GRAPHIFY_TOKEI_MAX_FILES=5000

# ── Codex subscription (GPT-5.5 via local CLI) ──────────────────
# No env var is needed. Install Codex CLI and run:
#   codex login
# Then choose `gpt-5.6-sol`, `gpt-5.6-terra`, `gpt-5.6-luna`, or `codex:<model>`.

# ── Composio app connectors ─────────────────────────────────────
# Platform key for Capabilities / Review / Code Anything app connectors
# (GitHub, Slack, Linear, etc.). Without this, the Capabilities catalog
# and Composio-backed GitHub proxy cannot start sessions.
# Create a key at https://platform.composio.dev
COMPOSIO_API_KEY=
# Optional overrides:
# COMPOSIO_BASE_URL=https://backend.composio.dev
# COMPOSIO_USER_ID=rlm-wiki-owner

# ── Optional ────────────────────────────────────────────────────
# DATABASE_URL=        # Railway private Postgres URL for deployed app history
# DATABASE_PUBLIC_URL= # Railway public Postgres URL for local dev history
# GITHUB_TOKEN=        # For cloning private repos (rlm-bun picks this up)
# RLM_WIKI_RUN_MODE=inline
#   inline: current MVP request-owned SSE behavior.
#   detached: Postgres-backed bridge toward worker execution; falls back to inline
#   unless DATABASE_URL is configured.
#   worker: enqueue to Postgres; a Railway or Unikraft worker claims jobs.
# RLM_WIKI_JOB_LOCK_MS=60000
# RLM_WIKI_WORKER_ID=local-dev
# RLM_WIKI_SECRET_GRANT_KEY=
# RLM_WIKI_SECRET_GRANT_TTL_SECONDS=1800
#
# ── Unikraft Cloud compute (optional) ───────────────────────────
# When worker mode is on, the web service can spawn a one-shot microVM per
# enqueued wiki/code job. Railway stays the control plane (queue + SSE + grants).
# UNIKRAFT_API_KEY=
# UKC_METRO=fra
# RLM_WIKI_UNIKRAFT_DISPATCH=0
# RLM_WIKI_UNIKRAFT_IMAGE=oci://unikraft.io/<org>/rlm-wiki-worker:latest
# RLM_WIKI_UNIKRAFT_METRO=fra
# RLM_WIKI_UNIKRAFT_MEMORY_MB=4096
# RLM_WIKI_UNIKRAFT_VCPUS=1
# RLM_WIKI_UNIKRAFT_MAX_CONCURRENT=2
# RLM_WIKI_UNIKRAFT_JOB_TYPES=run.wiki_generate,run.code
# RLM_WIKI_UNIKRAFT_AUTOKILL_MS=2700000
# RLM_WIKI_UNIKRAFT_MAX_ATTEMPTS=2

# ── MVP auth / deployment ───────────────────────────────────────
# Production should run behind Cloudflare Access. `off` is local-only.
# AUTH_MODE=cloudflare_access
# RLM_WIKI_CF_ACCESS_TEAM_DOMAIN=https://rlmwiki.cloudflareaccess.com
# RLM_WIKI_CF_ACCESS_AUD=
# RLM_WIKI_ALLOWED_ORIGINS=https://rlmwiki.deepascii.com
#
# Local/dev convenience:
# AUTH_MODE=dev
# RLM_WIKI_DEV_USER_EMAIL=dev@example.com
#
# Conservative single-replica MVP limits:
# RLM_WIKI_MAX_GENERATE=1
# RLM_WIKI_MAX_ASK=3
# RLM_WIKI_MAX_CODE=1
# RLM_WIKI_MAX_REVIEW=1
