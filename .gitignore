node_modules/
storage/
.codify/
.agents/
.rlm-sessions/
.grok-wiki-*
*.log
.DS_Store
# bun.lock is Bun's plaintext lockfile — commit it for reproducible deploys.
# Ignore only the old binary variant.
bun.lockb
.env
.env.local
# graphify Python sidecar — set up as a local venv or symlink per-machine
.graphify-venv
# rlm-bun's graph output written into cloned-repo caches; ignore any that
# leak into the project dir.
graphify-out/
# Claude Code and editor local caches
.claude/tsc-cache/
.claude/cache/
.vercel

# Local agent / ShareNow session state (machine-specific, may hold secrets)
.sharenow/
.superpowers/

# Generated merge / marketing build outputs
dist/sharenow-merge-report/

# Local ideation scratch and superpowers session artifacts
docs/ideation/
docs/superpowers/artifacts/

# KB spike: raw live-agent replies captured by the KB_SPIKE_LIVE test block.
src/kb/__fixtures__/.live-output/

# Desktop release artifacts generated by scripts/build-desktop-server.ts.
apps/desktop/src-tauri/resources/bun/bun
apps/desktop/src-tauri/resources/server/rlm-wiki.js
apps/desktop/src-tauri/resources/dist/public/
apps/desktop/src-tauri/binaries/

# Launch-video render outputs (rebuild via: cd videos/<project> && npx hyperframes render)
videos/*/renders/

# Agent-skill symlink farms pointing into the ignored .agents/ directory
# (reinstall via: npx skills add heygen-com/hyperframes)
/skills/
.claude/skills/
